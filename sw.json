const CACHE = 'tayyar-v1';
const FILES = [
  '/tyyyar/',
  '/tyyyar/index.html',
  '/tyyyar/style-1.css'
];

self.addEventListener('install', e => {
  e.waitUntil(caches.open(CACHE).then(c => c.addAll(FILES)));
});

self.addEventListener('fetch', e => {
  e.respondWith(
    caches.match(e.request).then(r => r || fetch(e.request))
  );
});